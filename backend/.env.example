NODE_ENV=production
PORT=3000
APP_ORIGIN=https://misticaura.com.au
PUBLIC_APP_URL=https://misticaura.com.au

# Hostinger managed MySQL credentials
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false

SESSION_DAYS=14
SESSION_COOKIE_NAME=mistic_session
CSRF_COOKIE_NAME=mistic_csrf
APP_ENCRYPTION_KEY=

# Transactional email. Leave blank during initial testing; links are logged to the server.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Mistic Aura <hello@misticaura.com.au>
SUPPORT_EMAIL=

# Stripe. Leave blank until payment testing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=aud
